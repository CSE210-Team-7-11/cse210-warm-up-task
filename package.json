{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run docs:build",
    "lint": "oxlint",
    "test": "node --test",
    "test:coverage": "bash scripts/test-coverage.sh",
    "preview": "vite preview",
